# ─── E-Commerce API — Environment Variables ─────────────────────────────────
#
# Secrets are managed via Doppler (recommended):
#   doppler login && doppler setup && doppler run -- docker compose up
#
# Without Doppler: copy this file to .env, fill in real values, then:
#   docker compose up
#
# Never commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Databases ───────────────────────────────────────────
# MongoDB connection string (used when running services outside Docker)
MONGODB_URI=
REDIS_URL=redis://localhost:6379

# ─── Stripe ──────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# ─── Cloudinary ──────────────────────────────────────────
# Credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Rate Limiting ───────────────────────────────────────
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=1
