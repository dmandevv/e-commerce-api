.DS_Store
Thumbs.db

# TypeScript build info
tsconfig.tsbuildinfo

# Compiled files that end up in src/ (should be in dist/)
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map

# Compiled scripts (keep seed.js for production use)
!scripts/seed.js
scripts/*.js.map
scripts/*.d.ts
scripts/*.d.ts.map